{
  "openapi": "3.1.0",
  "info": {
    "title": "hello-ts",
    "version": "0.1.0",
    "description": "The first swhurl example app: says hello and repeats itself"
  },
  "components": {
    "schemas": {
      "Hello": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "hello from hello-ts"
          },
          "service": {
            "type": "string"
          },
          "caller": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "app",
                  "user",
                  "anonymous"
                ]
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          "visits": {
            "type": "integer",
            "description": "How many times it was asked, when the app keeps a database"
          },
          "event": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "description": "The event this request published, if any"
          },
          "traceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message",
          "service",
          "caller",
          "event",
          "traceId"
        ]
      },
      "Repeated": {
        "type": "object",
        "properties": {
          "times": {
            "type": "integer",
            "example": 2
          },
          "text": {
            "type": "string",
            "example": "hello hello"
          }
        },
        "required": [
          "times",
          "text"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Say hello and name the caller",
        "responses": {
          "200": {
            "description": "A greeting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hello"
                }
              }
            }
          }
        }
      }
    },
    "/repeat": {
      "get": {
        "summary": "Repeat the greeting up to 100 times",
        "parameters": [
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 1,
              "example": 2,
              "description": "More than 100 is answered as 100"
            },
            "required": false,
            "description": "More than 100 is answered as 100",
            "name": "times",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The greeting, repeated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repeated"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
