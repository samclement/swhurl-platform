# Base configuration for platform Makefile targets

# Domain
BASE_DOMAIN=homelab.swhurl.com

# Host dynamic DNS (Route53 A records updated by systemd timer)
DYNAMIC_DNS_RECORDS=homelab.swhurl.com,*.homelab.swhurl.com

# Skip verification in make install (useful for quick iteration)
FEAT_VERIFY=true

# Timeout for runtime-input propagation wait (seconds)
TIMEOUT_SECS=300
