# Managed template for the nightly backups (make host-backup): ClickStack MongoDB, then app SQLite databases
[Unit]
Description=Encrypted ClickStack MongoDB and app SQLite backups, copied to S3
Wants=network-online.target
After=network-online.target k3s.service

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__REPO_DIR__
Environment=HOME=__RUN_HOME__
Environment=KUBECONFIG=__RUN_HOME__/.kube/config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Keep at most two files of about 5 MiB: rotate before each run once the log
# passes 5 MiB (+ = as root, since the directory is root's; $$ and %% are
# systemd escapes for $ and %).
ExecStartPre=+/bin/sh -c 'f=/var/log/swhurl-platform/swhurl-backup-mongodb.log; if [ "$$(stat -c %%s "$$f" 2>/dev/null || echo 0)" -gt 5242880 ]; then mv -f "$$f" "$$f.1"; fi'
ExecStart=/usr/bin/make backup-mongodb
# Runs only if the MongoDB backup succeeded; make verify-platform flags either one going stale.
ExecStart=/usr/bin/make backup-sqlite
# Output goes to a file the OTel DaemonSet reads (service.name from the file name);
# the journal keeps start, finish and failure lines.
StandardOutput=append:/var/log/swhurl-platform/swhurl-backup-mongodb.log
StandardError=append:/var/log/swhurl-platform/swhurl-backup-mongodb.log
