# Managed template for the host connectivity probe (make host-probe)
[Unit]
Description=Connectivity probe (gateway, resolver DNS, public DNS, ICMP, TCP)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__REPO_DIR__
Environment=HOME=__RUN_HOME__
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Keep at most two files of about 5 MiB: rotate before each run once the log
# passes 5 MiB (+ = as root, since the directory is root's; $$ and %% are
# systemd escapes for $ and %). At one line a minute that is roughly a month.
ExecStartPre=+/bin/sh -c 'f=/var/log/swhurl-platform/connectivity-probe.log; if [ "$$(stat -c %%s "$$f" 2>/dev/null || echo 0)" -gt 5242880 ]; then mv -f "$$f" "$$f.1"; fi'
ExecStart=/usr/bin/python3 -u __REPO_DIR__/host/connectivity-probe.py
# Output goes to a file the OTel DaemonSet reads (service.name from the file name);
# the journal keeps start, finish and failure lines.
StandardOutput=append:/var/log/swhurl-platform/connectivity-probe.log
StandardError=append:/var/log/swhurl-platform/connectivity-probe.log
