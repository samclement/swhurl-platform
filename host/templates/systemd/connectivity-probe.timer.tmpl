# Managed template for the host connectivity probe timer (make host-probe)
[Unit]
Description=Run the connectivity probe every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
# Without this systemd may delay a 1min timer by up to 1min to coalesce wakeups.
AccuracySec=1s

[Install]
WantedBy=timers.target
