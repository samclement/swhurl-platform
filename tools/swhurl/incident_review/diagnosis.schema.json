{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "likely_cause": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "proposed_files": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "proposed_tests": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "recommend_no_change": {"type": "boolean"}
  },
  "required": [
    "summary",
    "likely_cause",
    "confidence",
    "evidence_refs",
    "unresolved_questions",
    "proposed_files",
    "proposed_tests",
    "recommend_no_change"
  ]
}
