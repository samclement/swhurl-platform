{
  "apiVersion": "helm.toolkit.fluxcd.io/v2",
  "kind": "HelmRelease",
  "metadata": {
    "name": "hello",
    "namespace": "hello-staging",
    "annotations": {
      "platform.swhurl.com/render": "01da71127d5ed093c9e4eaff12d14ab2fdac91ead6445275bc27e9d80368663a"
    }
  },
  "spec": {
    "interval": "30m",
    "timeout": "3m",
    "chart": {
      "spec": {
        "chart": "app-template",
        "version": "5.2.1",
        "sourceRef": {
          "kind": "HelmRepository",
          "name": "bjw-s",
          "namespace": "flux-system"
        },
        "interval": "30m"
      }
    },
    "install": {
      "remediation": {
        "retries": 1
      }
    },
    "upgrade": {
      "remediation": {
        "retries": 1
      }
    },
    "values": {
      "defaultPodOptions": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 101,
          "runAsGroup": 101,
          "fsGroup": 101,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      "controllers": {
        "main": {
          "containers": {
            "main": {
              "image": {
                "repository": "docker.io/nginxinc/nginx-unprivileged",
                "tag": "1.27-alpine"
              },
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                },
                "limits": {
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "env": {
                "SWHURL_APP": "hello",
                "SWHURL_ENV": "staging",
                "SWHURL_NOTIFY_URL": "http://notify.notify.svc.cluster.local:8080",
                "SWHURL_AUTH_ISSUER": "https://kubernetes.default.svc.cluster.local",
                "SWHURL_AUTH_KEYS": "synthetic-unassessed-config"
              },
              "probes": {
                "readiness": {
                  "enabled": true,
                  "custom": true,
                  "spec": {
                    "httpGet": {
                      "path": "/",
                      "port": 8080
                    }
                  }
                },
                "liveness": {
                  "enabled": true,
                  "custom": true,
                  "spec": {
                    "httpGet": {
                      "path": "/",
                      "port": 8080
                    }
                  }
                },
                "startup": {
                  "enabled": true,
                  "custom": true,
                  "spec": {
                    "httpGet": {
                      "path": "/",
                      "port": 8080
                    },
                    "periodSeconds": 5,
                    "failureThreshold": 24
                  }
                }
              }
            }
          }
        }
      },
      "persistence": {
        "tmp": {
          "type": "emptyDir",
          "globalMounts": [
            {
              "path": "/tmp"
            }
          ]
        },
        "tokens": {
          "type": "projected",
          "sources": [
            {
              "serviceAccountToken": {
                "audience": "notify",
                "expirationSeconds": 600,
                "path": "notify/token"
              }
            }
          ],
          "globalMounts": [
            {
              "path": "/var/run/swhurl/tokens",
              "readOnly": true
            }
          ]
        },
        "data": {
          "type": "persistentVolumeClaim",
          "size": "1Gi",
          "globalMounts": [
            {
              "path": "/data"
            }
          ]
        }
      },
      "service": {
        "main": {
          "controller": "main",
          "ports": {
            "http": {
              "port": 8080
            }
          }
        }
      },
      "ingress": {
        "main": {
          "className": "traefik",
          "annotations": {
            "cert-manager.io/cluster-issuer": "letsencrypt-prod",
            "traefik.ingress.kubernetes.io/router.middlewares": "ingress-oauth-auth-shared@kubernetescrd"
          },
          "hosts": [
            {
              "host": "staging-hello.homelab.swhurl.com",
              "paths": [
                {
                  "path": "/",
                  "service": {
                    "identifier": "main",
                    "port": "http"
                  }
                }
              ]
            }
          ],
          "tls": [
            {
              "hosts": [
                "staging-hello.homelab.swhurl.com"
              ],
              "secretName": "hello-tls"
            }
          ]
        }
      }
    }
  }
}
