{
  "kind": "v2-compilation",
  "version": 1,
  "id": "comp-sha256:9880014e779e2a0837428bb6acf01944d5766707d748dc8177ab5fab205bfa07",
  "inputs": {
    "app": "app-sha256:50aa37430360ade5a48ce7d5c968b521b57e91bf8a1c4501fb14fc10d2672e0f",
    "release": "rel-sha256:b357d4173dc8d515f46c6b3f019b744b59ee97d5d30f03ce1e3a9532f9bf904c",
    "instance": "inst-sha256:321613e780631d2d0a2a62773f24c1d9a26b37fffcd6cb370b0414eda0fb1663",
    "profile": "prof-sha256:20ea752df2122d3938202e9ab7569daad7690786e145f19f4e2714f3cdf18356",
    "calls": ""
  },
  "files": [
    {
      "path": "v2-apps/instances/demo-orders/prod/namespace.json",
      "document": {
        "apiVersion": "v1",
        "kind": "Namespace",
        "metadata": {
          "labels": {
            "platform.swhurl.com/app": "demo-orders",
            "platform.swhurl.com/environment": "prod",
            "platform.swhurl.com/exposure": "private",
            "platform.swhurl.com/managed": "true",
            "platform.swhurl.com/team": "demo"
          },
          "name": "demo-orders-prod"
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/prod/helmrelease.json",
      "document": {
        "apiVersion": "helm.toolkit.fluxcd.io/v2",
        "kind": "HelmRelease",
        "metadata": {
          "name": "demo-orders",
          "namespace": "demo-orders-prod"
        },
        "spec": {
          "chart": {
            "spec": {
              "chart": "app-template",
              "interval": "30m",
              "sourceRef": {
                "kind": "HelmRepository",
                "name": "bjw-s",
                "namespace": "flux-system"
              },
              "version": "5.2.1"
            }
          },
          "install": {
            "remediation": {
              "retries": 1
            }
          },
          "interval": "30m",
          "timeout": "3m",
          "upgrade": {
            "remediation": {
              "retries": 1
            }
          },
          "values": {
            "controllers": {
              "main": {
                "containers": {
                  "main": {
                    "env": {
                      "HOST_IP": {
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "status.hostIP"
                          }
                        }
                      },
                      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://$(HOST_IP):4318",
                      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
                      "OTEL_SERVICE_NAME": "demo-orders",
                      "SWHURL_APP": "demo-orders",
                      "SWHURL_ENV": "prod",
                      "SWHURL_NOTIFY_URL": "http://notify.notify.svc.cluster.local:8080"
                    },
                    "image": {
                      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                      "repository": "ghcr.io/samclement/demo-orders"
                    },
                    "probes": {
                      "liveness": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          }
                        }
                      },
                      "readiness": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          }
                        }
                      },
                      "startup": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "failureThreshold": 24,
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          },
                          "periodSeconds": 5
                        }
                      }
                    },
                    "resources": {
                      "limits": {
                        "memory": "256Mi"
                      },
                      "requests": {
                        "cpu": "10m",
                        "memory": "256Mi"
                      }
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "readOnlyRootFilesystem": true
                    }
                  }
                },
                "replicas": 1
              }
            },
            "defaultPodOptions": {
              "automountServiceAccountToken": false,
              "securityContext": {
                "fsGroup": 65532,
                "runAsGroup": 65532,
                "runAsNonRoot": true,
                "runAsUser": 65532,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            },
            "persistence": {
              "tmp": {
                "globalMounts": [
                  {
                    "path": "/tmp"
                  }
                ],
                "type": "emptyDir"
              },
              "tokens": {
                "globalMounts": [
                  {
                    "path": "/var/run/swhurl/tokens",
                    "readOnly": true
                  }
                ],
                "sources": [
                  {
                    "serviceAccountToken": {
                      "audience": "notify",
                      "expirationSeconds": 600,
                      "path": "notify/token"
                    }
                  }
                ],
                "type": "projected"
              }
            },
            "service": {
              "main": {
                "controller": "main",
                "ports": {
                  "http": {
                    "port": 8080
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/prod/resourcequota.json",
      "document": {
        "apiVersion": "v1",
        "kind": "ResourceQuota",
        "metadata": {
          "name": "demo-orders",
          "namespace": "demo-orders-prod"
        },
        "spec": {
          "hard": {
            "limits.memory": "4Gi",
            "pods": "14",
            "requests.cpu": "2",
            "requests.memory": "2Gi"
          }
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/prod/networkpolicy.json",
      "document": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": {
          "name": "demo-orders",
          "namespace": "demo-orders-prod"
        },
        "spec": {
          "egress": [
            {
              "ports": [
                {
                  "port": 4318,
                  "protocol": "TCP"
                }
              ],
              "to": [
                {
                  "ipBlock": {
                    "cidr": "192.168.1.200/32"
                  }
                }
              ]
            }
          ],
          "ingress": [],
          "podSelector": {
            "matchLabels": {
              "app.kubernetes.io/instance": "demo-orders"
            }
          },
          "policyTypes": [
            "Ingress",
            "Egress"
          ]
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/prod/kustomization.yaml",
      "document": {
        "apiVersion": "kustomize.config.k8s.io/v1beta1",
        "kind": "Kustomization",
        "resources": [
          "namespace.json",
          "helmrelease.json",
          "resourcequota.json",
          "networkpolicy.json"
        ]
      }
    },
    {
      "path": "clusters/home/app-demo-orders-prod.json",
      "document": {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "app-demo-orders-prod",
          "namespace": "flux-system"
        },
        "spec": {
          "dependsOn": [
            {
              "name": "infra-base"
            }
          ],
          "interval": "10m",
          "path": "./v2-apps/instances/demo-orders/prod",
          "prune": true,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "swhurl-platform"
          },
          "timeout": "3m",
          "wait": true
        }
      }
    }
  ],
  "inventory": [
    {
      "group": "",
      "kind": "Namespace",
      "namespace": "",
      "name": "demo-orders-prod",
      "owner": "demo-orders/prod"
    },
    {
      "group": "helm.toolkit.fluxcd.io",
      "kind": "HelmRelease",
      "namespace": "demo-orders-prod",
      "name": "demo-orders",
      "owner": "demo-orders/prod"
    },
    {
      "group": "",
      "kind": "ResourceQuota",
      "namespace": "demo-orders-prod",
      "name": "demo-orders",
      "owner": "demo-orders/prod"
    },
    {
      "group": "networking.k8s.io",
      "kind": "NetworkPolicy",
      "namespace": "demo-orders-prod",
      "name": "demo-orders",
      "owner": "demo-orders/prod"
    },
    {
      "group": "kustomize.toolkit.fluxcd.io",
      "kind": "Kustomization",
      "namespace": "flux-system",
      "name": "app-demo-orders-prod",
      "owner": "demo-orders/prod"
    }
  ],
  "registrations": [
    "clusters/home/app-demo-orders-prod.json"
  ]
}
