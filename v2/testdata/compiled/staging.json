{
  "kind": "v2-compilation",
  "version": 1,
  "id": "comp-sha256:844153ca9d64d3203ae862c39495ccc99fec0b9ba4c57757ebfe4f05b9d118f0",
  "inputs": {
    "app": "app-sha256:50aa37430360ade5a48ce7d5c968b521b57e91bf8a1c4501fb14fc10d2672e0f",
    "release": "rel-sha256:760d0a77db10fe257ba80d01bc5e4d351e4c1d590eafad31569ad7aeebc28ce5",
    "instance": "inst-sha256:e4d0575879108d11a53fcd81304bd7223711337973c980301394d6810fd05069",
    "profile": "prof-sha256:20ea752df2122d3938202e9ab7569daad7690786e145f19f4e2714f3cdf18356",
    "calls": ""
  },
  "files": [
    {
      "path": "v2-apps/instances/demo-orders/staging/namespace.json",
      "document": {
        "apiVersion": "v1",
        "kind": "Namespace",
        "metadata": {
          "labels": {
            "platform.swhurl.com/app": "demo-orders",
            "platform.swhurl.com/environment": "staging",
            "platform.swhurl.com/exposure": "private",
            "platform.swhurl.com/managed": "true",
            "platform.swhurl.com/team": "demo"
          },
          "name": "demo-orders-staging"
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/helmrelease.json",
      "document": {
        "apiVersion": "helm.toolkit.fluxcd.io/v2",
        "kind": "HelmRelease",
        "metadata": {
          "annotations": {
            "platform.swhurl.com/api-description": "/openapi.json",
            "platform.swhurl.com/offers": "bbbbbbb"
          },
          "name": "demo-orders",
          "namespace": "demo-orders-staging"
        },
        "spec": {
          "chart": {
            "spec": {
              "chart": "app-template",
              "interval": "30m",
              "sourceRef": {
                "kind": "HelmRepository",
                "name": "bjw-s",
                "namespace": "flux-system"
              },
              "version": "5.2.1"
            }
          },
          "install": {
            "remediation": {
              "retries": 1
            }
          },
          "interval": "30m",
          "timeout": "3m",
          "upgrade": {
            "remediation": {
              "retries": 1
            }
          },
          "values": {
            "controllers": {
              "main": {
                "containers": {
                  "main": {
                    "env": {
                      "HOST_IP": {
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "status.hostIP"
                          }
                        }
                      },
                      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://$(HOST_IP):4318",
                      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
                      "OTEL_SERVICE_NAME": "demo-orders",
                      "SWHURL_APP": "demo-orders",
                      "SWHURL_DESCRIPTION": "Demo orders service",
                      "SWHURL_ENV": "staging",
                      "SWHURL_NOTIFY_URL": "http://notify.notify.svc.cluster.local:8080"
                    },
                    "image": {
                      "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                      "repository": "ghcr.io/samclement/demo-orders"
                    },
                    "probes": {
                      "liveness": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          }
                        }
                      },
                      "readiness": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          }
                        }
                      },
                      "startup": {
                        "custom": true,
                        "enabled": true,
                        "spec": {
                          "failureThreshold": 24,
                          "httpGet": {
                            "path": "/healthz",
                            "port": 8080
                          },
                          "periodSeconds": 5
                        }
                      }
                    },
                    "resources": {
                      "limits": {
                        "memory": "128Mi"
                      },
                      "requests": {
                        "cpu": "10m",
                        "memory": "128Mi"
                      }
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "readOnlyRootFilesystem": true
                    }
                  }
                },
                "replicas": 2
              }
            },
            "defaultPodOptions": {
              "automountServiceAccountToken": false,
              "securityContext": {
                "fsGroup": 65532,
                "runAsGroup": 65532,
                "runAsNonRoot": true,
                "runAsUser": 65532,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            },
            "persistence": {
              "tmp": {
                "globalMounts": [
                  {
                    "path": "/tmp"
                  }
                ],
                "type": "emptyDir"
              },
              "tokens": {
                "globalMounts": [
                  {
                    "path": "/var/run/swhurl/tokens",
                    "readOnly": true
                  }
                ],
                "sources": [
                  {
                    "serviceAccountToken": {
                      "audience": "notify",
                      "expirationSeconds": 600,
                      "path": "notify/token"
                    }
                  }
                ],
                "type": "projected"
              }
            },
            "service": {
              "main": {
                "controller": "main",
                "ports": {
                  "http": {
                    "port": 8080
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/resourcequota.json",
      "document": {
        "apiVersion": "v1",
        "kind": "ResourceQuota",
        "metadata": {
          "name": "demo-orders",
          "namespace": "demo-orders-staging"
        },
        "spec": {
          "hard": {
            "limits.memory": "4Gi",
            "pods": "14",
            "requests.cpu": "2",
            "requests.memory": "2Gi"
          }
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/networkpolicy.json",
      "document": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": {
          "name": "demo-orders",
          "namespace": "demo-orders-staging"
        },
        "spec": {
          "egress": [
            {
              "ports": [
                {
                  "port": 4318,
                  "protocol": "TCP"
                }
              ],
              "to": [
                {
                  "ipBlock": {
                    "cidr": "192.168.1.200/32"
                  }
                }
              ]
            }
          ],
          "ingress": [],
          "podSelector": {
            "matchLabels": {
              "app.kubernetes.io/instance": "demo-orders"
            }
          },
          "policyTypes": [
            "Ingress",
            "Egress"
          ]
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/image-repository.json",
      "document": {
        "apiVersion": "image.toolkit.fluxcd.io/v1",
        "kind": "ImageRepository",
        "metadata": {
          "labels": {
            "platform.swhurl.com/app": "demo-orders",
            "platform.swhurl.com/managed": "true"
          },
          "name": "demo-orders",
          "namespace": "flux-system"
        },
        "spec": {
          "image": "ghcr.io/samclement/demo-orders",
          "interval": "1h"
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/image-policy.json",
      "document": {
        "apiVersion": "image.toolkit.fluxcd.io/v1",
        "kind": "ImagePolicy",
        "metadata": {
          "labels": {
            "platform.swhurl.com/app": "demo-orders",
            "platform.swhurl.com/managed": "true"
          },
          "name": "demo-orders-staging",
          "namespace": "flux-system"
        },
        "spec": {
          "digestReflectionPolicy": "Always",
          "filterTags": {
            "extract": "$run",
            "pattern": "^(?P<run>[0-9]+)-[0-9a-f]{7,40}$"
          },
          "imageRepositoryRef": {
            "name": "demo-orders"
          },
          "interval": "1h",
          "policy": {
            "numerical": {
              "order": "asc"
            }
          }
        }
      }
    },
    {
      "path": "v2-apps/instances/demo-orders/staging/kustomization.yaml",
      "document": {
        "apiVersion": "kustomize.config.k8s.io/v1beta1",
        "kind": "Kustomization",
        "resources": [
          "namespace.json",
          "helmrelease.json",
          "resourcequota.json",
          "networkpolicy.json",
          "image-repository.json",
          "image-policy.json"
        ]
      }
    },
    {
      "path": "clusters/home/app-demo-orders-staging.json",
      "document": {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "app-demo-orders-staging",
          "namespace": "flux-system"
        },
        "spec": {
          "dependsOn": [
            {
              "name": "infra-base"
            },
            {
              "name": "platform-image-automation"
            }
          ],
          "interval": "10m",
          "path": "./v2-apps/instances/demo-orders/staging",
          "prune": true,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "swhurl-platform"
          },
          "timeout": "3m",
          "wait": true
        }
      }
    }
  ],
  "inventory": [
    {
      "group": "",
      "kind": "Namespace",
      "namespace": "",
      "name": "demo-orders-staging",
      "owner": "demo-orders/staging"
    },
    {
      "group": "helm.toolkit.fluxcd.io",
      "kind": "HelmRelease",
      "namespace": "demo-orders-staging",
      "name": "demo-orders",
      "owner": "demo-orders/staging"
    },
    {
      "group": "",
      "kind": "ResourceQuota",
      "namespace": "demo-orders-staging",
      "name": "demo-orders",
      "owner": "demo-orders/staging"
    },
    {
      "group": "networking.k8s.io",
      "kind": "NetworkPolicy",
      "namespace": "demo-orders-staging",
      "name": "demo-orders",
      "owner": "demo-orders/staging"
    },
    {
      "group": "image.toolkit.fluxcd.io",
      "kind": "ImageRepository",
      "namespace": "flux-system",
      "name": "demo-orders",
      "owner": "demo-orders/staging"
    },
    {
      "group": "image.toolkit.fluxcd.io",
      "kind": "ImagePolicy",
      "namespace": "flux-system",
      "name": "demo-orders-staging",
      "owner": "demo-orders/staging"
    },
    {
      "group": "kustomize.toolkit.fluxcd.io",
      "kind": "Kustomization",
      "namespace": "flux-system",
      "name": "app-demo-orders-staging",
      "owner": "demo-orders/staging"
    }
  ],
  "registrations": [
    "clusters/home/app-demo-orders-staging.json"
  ]
}
